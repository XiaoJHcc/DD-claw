# 复制为 .env 后填写。.env 已被 gitignore。

# NapCat / OneBot 11 HTTP 服务地址。
# 可选：config.json 配了 napcat 段就不用填（DD-claw 自建自管 name=dd-claw 的专属
# 端口条目，自动选高位空闲端口、冲突自动换）；这里留作手动覆盖/兜底
NAPCAT_BASE_URL=http://127.0.0.1:3000

# NapCat 的 access token。没设就留空
NAPCAT_TOKEN=

# 数据库路径，可留空用默认 data/dd-claw.db
DB_PATH=

# 日志级别 debug | info | warn | error
LOG_LEVEL=info

# LLM API keys（可选）。推荐在控制面板的 LLM 卡片里填（只写不读、热更新免重启）；
# 这里的是兜底来源——面板填写优先于 .env。变量名由 config.json 的
# llm.providers[].keyEnvs 引用，同 provider 配多个变量 = 多 key 池轮询
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
