# 统一以 LF 存入仓库，检出时按平台转换
* text=auto eol=lf

# 明确指定文本类型，避免误判
*.ts    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Windows 脚本必须保持 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制，不做行尾转换
*.db     binary
*.jpg    binary
*.jpeg   binary
*.png    binary
*.wav    binary
*.node   binary
